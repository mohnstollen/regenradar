<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/icon" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/wx_partly_cloudy_day" android:contentDescription="Wetter" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12°" android:textSize="26sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
            <TextView android:id="@+id/desc" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Teilweise bewölkt · gefühlt 10°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp">
            <TextView android:id="@+id/place" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Herzogenaurach" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:maxWidth="150dp" />
            <TextView android:id="@+id/hilo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↑ 14°  ↓ 7°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginTop="3dp" />
            <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Stand 15:05" android:textSize="10sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/warn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
        android:background="@drawable/warn_moderate" android:textColor="#5A3000" android:textSize="12sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"
        android:text="Amtliche WARNUNG vor STURMBÖEN" />
    <TextView android:id="@+id/rain_on" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Regen in ca. 25 min (gegen 15:30)" android:textSize="12sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="4dp" android:visibility="gone" />
    <TextView android:id="@+id/rain_off" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kein Regen in den nächsten 2 Stunden" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h0_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="16:00" android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/h0_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_partly_cloudy_day" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
                <TextView android:id="@+id/h0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="13°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/h0_prob" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h1_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="18:00" android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/h1_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_cloudy" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
                <TextView android:id="@+id/h1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="11°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/h1_prob" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="20 %" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="20:00" android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/h2_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_rain" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
                <TextView android:id="@+id/h2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="9°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/h2_prob" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="60 %" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h3_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="22:00" android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/h3_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_partly_cloudy_night" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
                <TextView android:id="@+id/h3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="8°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/h3_prob" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h4_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="00:00" android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/h4_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_clear_night" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
                <TextView android:id="@+id/h4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="7°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/h4_prob" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="5dp" android:orientation="horizontal" android:background="@color/w_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d0_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Di 27." android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/d0_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_partly_cloudy_day" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:id="@+id/d0_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="13°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/d0_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/d0_mm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d1_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mi 28." android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/d1_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_showers" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:id="@+id/d1_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="11°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/d1_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="6°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/d1_mm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2 mm" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d2_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Do 29." android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/d2_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_rain" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:id="@+id/d2_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="9°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/d2_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="6°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/d2_mm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="8 mm" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d3_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fr 30." android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/d3_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_cloudy" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:id="@+id/d3_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/d3_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="4°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/d3_mm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d4_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sa 31." android:textSize="11sp" android:textColor="@color/w_muted" android:includeFontPadding="false" />
            <ImageView android:id="@+id/d4_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="2dp"
                android:src="@drawable/wx_clear_day" android:contentDescription="Wetter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:id="@+id/d4_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12°" android:textSize="13sp" android:textColor="@color/w_text" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/d4_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2°" android:textSize="12sp" android:textColor="@color/w_muted" android:includeFontPadding="false" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/d4_mm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="@color/w_rain" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
